[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="platform"

[physics]

; web 原型是 120Hz 定步长（SIM_HZ=120）。保持一致，手感数字才不用重标定。
common/physics_ticks_per_second=120

[rendering]

; 蜡笔是**连续色调**，不是像素画：必须线性过滤。
; 之前设成 nearest（0）是按像素风配的，结果蜡笔笔触被放大时出锯齿，
; 亚像素位移也被切成孤立跳变（沸腾线成片率只有 31%）。
textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.027, 0.043, 1)
