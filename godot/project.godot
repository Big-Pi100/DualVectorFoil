[autoload]

WorldState="*res://core/WorldState.gd"
SceneTransition="*res://core/SceneTransition.tscn"
TravelJournal="*res://ui/TravelJournal.tscn"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
StoryDirector="*res://dialogue/StoryDirector.gd"
MobileTuner="*res://core/MobileTuner.gd"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="one_way_platform"
2d_physics/layer_3="enemy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Android 导出要求：同时导入 ETC2/ASTC 压缩纹理（否则 Godot 拒绝导出 APK）
textures/vram_compression/import_etc2_astc=true
